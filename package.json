{
  "name": "markdown-preview",
  "version": "0.1.0",
  "description": "markdown preview plugin for (neo)vim",
  "repository": "https://github.com/dcai/markdown-preview.nvim.git",
  "author": "年糕小豆汤 <ooiss@qq.com>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "node --check src/attach/index.ts && node --check src/util/logger.ts && node --check src/util/getIP.ts && node --check src/util/opener.ts",
    "build-app": "cd app && vite build",
    "build-server": "cd app && vite build --mode server",
    "build": "npm run build-server && npm run build-app"
  },
  "devDependencies": {
    "@chemzqm/neovim": "^6.4.0",
    "chart.js": "^2.7.3",
    "highlight.js": "^10.4.1",
    "log4js": "^6.9.1",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-toc-done-right": "^4.2.0",
    "plantuml-encoder": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vite": "^8.2.1"
  }
}
